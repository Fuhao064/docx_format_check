{
  "name": "scriptor",
  "version": "2.0.0",
  "description": "Scriptor - 智能文档格式检查与更正工具",
  "author": "Scriptor Team",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.scriptor.desktop",
    "productName": "Scriptor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.14",
    "@heroicons/vue": "^2.0.18",
    "@primeuix/themes": "^1.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/vue-table": "^8.21.2",
    "@vue-office/docx": "^1.6.3",
    "@vueuse/core": "^10.11.1",
    "axios": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "lucide-vue-next": "^0.479.0",
    "mammoth": "^1.9.0",
    "marked": "^15.0.7",
    "pinia": "^2.0.36",
    "primevue": "^4.3.2",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.0.2",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "vue": "^3.2.47",
    "vue-demi": "^0.14.6",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^4.3.9",
    "wait-on": "^7.0.0"
  }
}
