        {
            "id": "para18",
            "type": "heading2",
            "content": "4社会融入与个人价值实现",
            "meta": {
                "paragraph_format": {
                    "alignment": "justify",
                    "first_line_indent": 0,
                    "left_indent": 0,
                    "right_indent": 0,
                    "before_spacing": 0,
